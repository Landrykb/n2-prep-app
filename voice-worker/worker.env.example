# Copy to worker.env on the VM (chmod 600). The secret is generated by
# Orion and set BOTH here and as the Supabase function secret
# VOICE_WORKER_SECRET — the two must match. Never commit a filled copy.
VOICE_QUEUE_URL=https://<project-ref>.supabase.co/functions/v1/voice-queue
VOICE_WORKER_SECRET=
