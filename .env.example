# Supabase project credentials (public, safe for the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenRouter config (used only in Supabase Edge Functions, never the browser bundle)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# Optional app URL for OpenRouter HTTP-Referer header
APP_URL=https://jpn2easy.vercel.app
